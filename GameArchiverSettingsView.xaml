<UserControl x:Class="GameArchiver.GameArchiverSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="8">
    <TextBlock Text="Archive root" FontWeight="Bold" />
    <TextBlock Text="Games are moved beneath this folder." Margin="0,2,0,4" Opacity="0.7" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Text="{Binding ArchiveRoot, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
      <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Padding="12,3" Click="BrowseArchiveRoot_Click" />
    </Grid>
    <TextBlock Text="Source roots (optional)" FontWeight="Bold" Margin="0,14,0,0" />
    <TextBlock Text="One folder per line. Matching roots are removed from the archived relative path. If empty, the drive letter is used." Margin="0,2,0,4" TextWrapping="Wrap" Opacity="0.7" />
    <TextBox Text="{Binding SourceRoots, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" VerticalScrollBarVisibility="Auto" />
    <TextBlock Text="Archived tag name" FontWeight="Bold" Margin="0,14,0,4" />
    <TextBox Text="{Binding ArchivedTagName, UpdateSourceTrigger=PropertyChanged}" />
    <CheckBox IsChecked="{Binding AllowManagedGames}" Content="Allow launcher-managed games" Margin="0,16,0,0" FontWeight="Bold" />
    <TextBlock Text="Warning: Game Archiver moves the files and updates Playnite only. Steam, Epic, GOG, EA, and other launcher databases are not updated. Launch these games through Playnite after restoring them." Margin="20,4,0,0" TextWrapping="Wrap" Opacity="0.7" />
  </StackPanel>
</UserControl>
